# ── Database ─────────────────────────────────────────────
# Postgres connection string. For local dev via Podman this points at the
# published port (5433). Inside compose the service name is `db`.
DATABASE_URL=postgresql://teamweb:teamweb@localhost:5433/teamweb

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Set to 1 to enable legacy email/password login fallback for break-glass or rollback.
# When omitted or 0, users sign in directly with their Jira API token.
# LEGACY_PASSWORD_LOGIN=1

# Bootstrap admin created by `npm run db:seed`
ADMIN_EMAIL=admin@team.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
# Optional: Jira username of the admin (used for notifications)
# ADMIN_JIRA_USERNAME=you@team

# Master key for encrypting each member's Jira/Bitbucket tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENCRYPTION_KEY=

# ── Jira Server / Data Center ────────────────────────────
JIRA_BASE_URL=
# Restricted system account used only by background sync/automation. Web and
# chat actions always require the signed-in user's encrypted personal token.
JIRA_USER=
JIRA_TOKEN=
# Auth style: "Bearer" (default, this Jira DC) or "basic" (username:apiToken)
JIRA_AUTH=Bearer
# Comma-separated project keys to sync + show (mobile projects by default)
JIRA_PROJECT_KEYS=CICM,EDM,EMA,EPM,ETM,MHRM,MR
# Extra JQL ANDed onto the default poll query (optional)
JIRA_JQL_EXTRA=
# Custom field id that stores story points, e.g. "customfield_10016".
# Leave empty to disable writing points back to Jira.
JIRA_POINTS_FIELD_ID=
# One Jira HTTP request is aborted after this many milliseconds.
JIRA_REQUEST_TIMEOUT_MS=15000
# Re-read this overlap window on incremental sync to avoid cursor edge gaps.
JIRA_SYNC_OVERLAP_SECONDS=300
# UI warns when the last successful Jira sync is older than this.
JIRA_FRESHNESS_MINUTES=5
# Board columns per project, matching each project's Jira board. Format:
#   KEY:col1|col2|col3,...   (columns are raw workflow status names, in order)
# Projects not listed auto-derive columns (to-do + in-progress states, with the
# done-family collapsed into one). Set these to exactly match your Jira boards,
# e.g.  JIRA_PROJECT_COLUMNS=EPM:Backlog|In Progress|Done,MR:Plan|To do|In Progress|Waiting For Deploy|READY FOR TEST|Done Test
JIRA_PROJECT_COLUMNS=

# Jira Issue Link Dependency Config (DEP-02)
# Link type semantic "Blocks": A is blocked by B -> B blocks A (B is child/dependency of A)
JIRA_DEPENDENCY_LINK_TYPE=Blocks
JIRA_DEPENDENCY_INWARD_LABEL=is blocked by
JIRA_DEPENDENCY_MAX_DEPTH=10
JIRA_DEPENDENCY_MAX_ISSUES=500

# ── Bitbucket Server / Data Center ───────────────────────
BITBUCKET_BASE_URL=
# Restricted system account used only to build the shared branch/PR read model.
# User-initiated branch actions never fall back to these credentials.
BITBUCKET_USER=
BITBUCKET_TOKEN=
# Comma-separated project/repo slugs
BITBUCKET_REPOS=
BITBUCKET_BASE_BRANCH=main

# ── Sentry ───────────────────────────────────────────────
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TOKEN=
# Override for self-hosted Sentry; empty => https://sentry.io
SENTRY_BASE_URL=https://sentry.io
# M2 — map a Sentry project slug to a Jira project, comma-separated, e.g.
#   SENTRY_PROJECT_MAPPINGS=mobile-app:EPM,employee-app:MHRM
# When set, imported Sentry issues are filed into the mapped Jira project
# instead of the first entry in JIRA_PROJECT_KEYS. Empty => single-project
# behaviour (file into JIRA_PROJECT_KEYS[0]).
SENTRY_PROJECT_MAPPINGS=

# ── AI / LLM ─────────────────────────────────────────────
# Provider: "openai" (OpenAI-compatible, default) or "ollama" (self-hosted).
LLM_PROVIDER=openai

# OpenAI-compatible API (OpenAI, Azure, vLLM, LM Studio, litellm, …).
# For the company-provided API, set OPENAI_BASE_URL to the gateway base URL
# (ending in /v1 if it's OpenAI-style), the API key, and the model name.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (only used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Allowed story-point values (Fibonacci by default)
POINT_SCALE=1,2,3,5,8,13
# Auto-score new unscored issues on the ai-score cron (on/off)
AI_AUTO_SCORE=false

# ── Behaviour ────────────────────────────────────────────
# Legacy: an issue is "stale" if not updated for this many days (and not Done).
# M8 uses per-status SLA thresholds below; STALE_DAYS is kept for backward
# compatibility with the /stale chat command.
STALE_DAYS=7
# M8 — per-status SLA thresholds (release-policy.md §11.2).
# Days in a given workflow state before the task is flagged stale.
STALE_BACKLOG_DAYS=30
STALE_TODO_DAYS=14
STALE_IN_PROGRESS_DAYS=5
STALE_REVIEW_DAYS=2
STALE_QA_DAYS=2
STALE_BLOCKED_DAYS=3
STALE_UNKNOWN_DAYS=7
# Re-notify the assignee after this many days if the task is still stale
# and the severity has not increased.
STALE_REMINDER_DAYS=7
# How often the poll-jira cron runs, in ms
POLL_INTERVAL_MS=60000
# Set to 1 to log Prisma SQL errors/warnings
# PRISMA_LOG=1

# ── Release policy (M2-02) ───────────────────────────────
# Status categories that count as "done" for release gates (comma-separated).
RELEASE_DONE_CATEGORIES=done
# Jira priority names that block a release (comma-separated).
RELEASE_BLOCKING_PRIORITIES=Blocker,Critical
# Source data must be synced within this many minutes for a release to be ready.
RELEASE_DATA_FRESHNESS_MINUTES=5
# Sentry levels that block a release (comma-separated).
SENTRY_BLOCKING_LEVELS=fatal
# REL-03 — required approval types before a release is ready (comma-separated),
# e.g. "qa,release_manager". Empty => no manual approval gate (default).
RELEASE_REQUIRED_APPROVALS=
# REL-04 — enable the mandatory CI gate (requires CI_GATE webhooks). Default off.
CI_GATE_ENABLED=false

# ── OPS-03: Health / freshness alerting ───────────────────
# A job with no successful run within this many minutes is treated as stale.
ALERT_STALE_CURSOR_MINUTES=10
# Grace window (ms) before a recovered condition is re-announced.
ALERT_RECOVERY_GRACE_MS=300000

# ── M4: Bulk operations ─────────────────────────────────
# Max concurrent Jira/Bitbucket calls per bulk operation.
BULK_CONCURRENCY=4
# Default branch-name template for bulk branch creation.
# Placeholders: {issue} {project} {number} {status}
BULK_BRANCH_TEMPLATE={project}-{number}

# ── M5: Webhooks ─────────────────────────────────────────
# Shared secrets used to verify inbound webhook signatures. Each source has
# its own secret; requests without a valid signature are rejected with 401.
#
# Jira (Server/DC): set the same value in Jira Admin > Webhooks as the
# "Secret key" (sent back as X-Atlassian-Token). Or configure a reverse proxy
# to compute X-Webhook-Signature = HMAC-SHA256(body, secret) in hex.
JIRA_WEBHOOK_SECRET=
# Sentry: the "Signing secret" of the webhook integration, sent as
# X-Sentry-Hook-Signature: sha256=<hex>.
SENTRY_WEBHOOK_SECRET=
# Bitbucket DC: the webhook secret, sent as X-Hub-Signature: sha256=<hex>.
BITBUCKET_WEBHOOK_SECRET=
# Generic CI: the shared secret; the CI must send X-Webhook-Signature =
# HMAC-SHA256(body, secret) in hex.
CI_WEBHOOK_SECRET=
# Cap on the raw payload stored per IntegrationEvent row (bytes).
WEBHOOK_MAX_PAYLOAD_BYTES=65536

# ── M5: Notification delivery ────────────────────────────
# Max push delivery attempts before the outbox row is marked failed.
NOTIFY_MAX_ATTEMPTS=5
# Base delay (ms) for exponential backoff between delivery attempts.
NOTIFY_BACKOFF_BASE_MS=60000

# ── Web Push (VAPID) ─────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@team.local

# ── M6: Chat integration (Discord) ───────────────────────
# Vendor-neutral ChatProvider; the first adapter is Discord (ADR-005).
# CHAT_PROVIDER selects the adapter (only "discord" is supported today).
CHAT_PROVIDER=discord
# Discord bot token used to post messages to the team channel.
DISCORD_BOT_TOKEN=
# Shared secret for verifying inbound Discord webhook signatures
# (HMAC-SHA256 of the raw body, sent as X-Discord-Signature).
DISCORD_WEBHOOK_SECRET=
# The channel id Team Task Web posts alerts and command results to.
DISCORD_CHANNEL_ID=
# Public base URL of this deployment, used to build web deep-links in chat.
PUBLIC_BASE_URL=http://localhost:3000
