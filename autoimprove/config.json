{
  "version": 2,
  "defaultProfile": "fast",
  "retryLimit": 3,
  "timeoutMs": 900000,
  "baselineCacheMaxAgeMinutes": 60,
  "checks": [
    {
      "id": "typecheck",
      "command": ["npm", "run", "typecheck"],
      "profiles": ["fast", "full"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "lint-targets",
      "command": ["node", "node_modules/eslint/bin/eslint.js", "--max-warnings=0"],
      "append": "files",
      "profiles": ["fast"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "targeted-tests",
      "command": ["npm", "test", "--", "--run"],
      "append": "tests",
      "profiles": ["fast"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "lint",
      "command": ["npm", "run", "lint"],
      "profiles": ["full"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "unit-tests",
      "command": ["npm", "test"],
      "profiles": ["full"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "production-build",
      "command": ["npm", "run", "build"],
      "profiles": ["full"],
      "mandatory": true,
      "enabled": true
    },
    {
      "id": "database-integration",
      "command": ["npm", "run", "test:db"],
      "profiles": ["full"],
      "mandatory": false,
      "enabled": false,
      "skipReason": "Cần TEST_DATABASE_URL riêng và dịch vụ PostgreSQL test; bật thủ công khi môi trường đã sẵn sàng."
    }
  ]
}
