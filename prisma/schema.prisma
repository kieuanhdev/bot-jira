generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  member
  release_manager
  admin
}

enum ReleaseStatus {
  draft
  checking
  ready
  blocked
  unknown
  released
}

model User {
  id             String        @id @default(cuid())
  email          String?       @unique
  passwordHash   String?
  displayName    String
  jiraUsername   String?
  jiraIdentityKey String?      @unique
  role           Role          @default(member)
  pushSubscription Json?

  // Per-user integration credentials (AES-256-GCM encrypted blobs).
  // When set, the app calls Jira/Bitbucket as *this* user.
  jiraUserEnc       String?
  jiraTokenEnc      String?
  jiraAuth          String?
  bitbucketUserEnc  String?
  bitbucketTokenEnc String?
  jiraVerifiedAt    DateTime?
  bitbucketVerifiedAt DateTime?

  preferences NotificationPreference?

  // Preferred project keys to show on this user's board.
  // Empty => show nothing on the board until they pick some.
  boardProjects String[]

  // True once the user has completed first-run onboarding (picked projects
  // after linking Jira). Gated by the (app) layout to force that step once.
  onboarded     Boolean  @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  watches        Watch[]
  notifications  Notification[]
  chatIdentities ChatIdentity[]
  chatCommands   ChatMessage[]
  chatConfirmations ChatMessageConfirmation[]
}

model IssueCache {
  jiraKey        String        @id
  projectKey     String        @default("")
  summary        String        @default("")
  description    String        @default("")
  status         String        @default("")
  statusCategory String        @default("unknown")
  statusChangedAt DateTime?
  assigneeJira   String?
  labels         String[]
  fixVersionIds  String[]
  fixVersionNames String[]
  priority       String        @default("")
  points         Int?
  storyField     String?
  type           String        @default("")
  dueDate        DateTime?
  timeSpent      Int?
  createdAt      DateTime?
  updatedAt      DateTime?
  lastSyncedAt   DateTime      @default(now())
  deletedAt      DateTime?
  raw            Json?
  comments       CommentCache[]
  aiScore        AiScore?
  releaseTasks   ReleaseTask[]
  staleSnapshots StaleSnapshot[]
  branches       BranchInfo[]

  @@index([status])
  @@index([projectKey])
  @@index([statusCategory])
  @@index([assigneeJira])
  @@index([lastSyncedAt])
}

model CommentCache {
  id         String     @id @default(cuid())
  jiraCommentId String? @unique
  jiraKey    String
  author     String
  body       String
  createdAt  DateTime?
  updatedAt  DateTime?
  syncedAt   DateTime   @default(now())
  issue      IssueCache @relation(fields: [jiraKey], references: [jiraKey], onDelete: Cascade)

  @@index([jiraKey])
}

model IssueLinkCache {
  id            String    @id @default(cuid())
  jiraLinkId    String    @unique
  linkTypeId    String
  linkTypeName  String
  inwardLabel   String
  outwardLabel  String

  // Với link B blocks A:
  // outwardKey = B, inwardKey = A
  outwardKey    String
  inwardKey     String

  lastSyncedAt  DateTime  @default(now())
  deletedAt     DateTime?

  @@index([outwardKey, deletedAt])
  @@index([inwardKey, deletedAt])
  @@index([linkTypeId, deletedAt])
}

model FixVersionPropagation {
  id             String    @id @default(cuid())
  rootKey        String
  dependencyKey  String
  jiraVersionId  String
  projectKey     String
  operationId    String?
  active         Boolean   @default(true)
  appliedAt      DateTime  @default(now())
  removedAt      DateTime?
  lastVerifiedAt DateTime?

  @@unique([rootKey, dependencyKey, jiraVersionId])
  @@index([dependencyKey, jiraVersionId, active])
  @@index([rootKey, jiraVersionId, active])
}

model IntegrationCursor {
  id            String    @id @default(cuid())
  integration   String
  scope         String
  cursor        String?
  lastStartedAt DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  stats         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([integration, scope])
  @@index([integration, lastSuccessAt])
}

model Watch {
  id          String     @id @default(cuid())
  userId      String
  jiraKey     String
  watchedAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jiraKey])
  @@index([jiraKey])
}

model Release {
  id            String        @id @default(cuid())
  version       String
  // Legacy label-based identity (CUR-09 fix in M3-01). Kept for backward
  // compatibility; no longer unique. New releases are identified by the
  // Jira Fix Version instead (projectKey + jiraVersionId).
  targetLabel   String        @default("")
  projectKey    String        @default("")
  jiraVersionId String?
  description   String        @default("")
  releaseDate   DateTime?
  createdById   String?
  releasedAt    DateTime?
  status        ReleaseStatus @default(draft)
  notes         String        @default("")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tasks         ReleaseTask[]
  releaseChecks ReleaseCheck[]
  approvals     ReleaseApproval[]
  gateOverrides ReleaseGateOverride[]

  @@unique([projectKey, jiraVersionId])
  @@index([projectKey])
}

model ReleaseTask {
  id         String    @id @default(cuid())
  releaseId  String
  jiraKey    String
  release    Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issue      IssueCache @relation(fields: [jiraKey], references: [jiraKey], onDelete: Cascade)

  @@unique([releaseId, jiraKey])
  @@index([jiraKey])
}

model ReleaseCheck {
  id          String   @id @default(cuid())
  releaseId   String
  triggeredBy String?
  status      String
  summary     String   @default("")
  blockers    Json?
  sourceTimes Json?
  createdAt   DateTime @default(now())
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  gates       ReleaseGateResult[]

  @@index([releaseId])
}

model ReleaseGateResult {
  id         String   @id @default(cuid())
  checkId    String
  gate       String
  state      String // "passed" | "failed" | "unknown" | "overridden"
  summary    String   @default("")
  details    Json?
  sourceTime DateTime?
  createdAt  DateTime @default(now())
  check      ReleaseCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([gate])
}

// REL-03 — Human approval of a release (QA / release manager). Recorded with
// an actor so an approval can be audited. A release may have several approvals
// (e.g. QA + release manager) per the release policy.
model ReleaseApproval {
  id           String    @id @default(cuid())
  releaseId    String
  type         String // "qa" | "release_manager"
  approvedById String
  note         String    @default("")
  approvedAt   DateTime  @default(now())
  revokedAt    DateTime?
  release      Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, revokedAt])
  @@index([approvedById])
}

// REL-03 — An explicit override of a single gate result, always with a reason
// and an actor. Never valid for `non_empty_release` (enforced in the gate
// engine). `revokedAt` / `expiresAt` make an override invalid when set/past.
model ReleaseGateOverride {
  id          String    @id @default(cuid())
  releaseId   String
  gate        String
  reason      String
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  release     Release   @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, gate, revokedAt, expiresAt])
  @@index([createdById])
}

// REL-04 — CI read model. One row per CI run, keyed by (provider, externalId).
// Populated from the CI webhook; the `ci` release gate reads the latest build
// for the release's commit(s). A build on a *different* commit is `unknown`,
// never passed (stale-CI fail-safe, plan §REL-04).
model CiBuildStatus {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  repo        String
  branch      String
  commitSha   String
  status      String // "pending" | "success" | "failed" | "cancelled"
  testStatus  String?
  url         String?
  startedAt   DateTime?
  completedAt DateTime?
  receivedAt  DateTime  @default(now())

  @@unique([provider, externalId])
  @@index([repo, branch, commitSha])
  @@index([repo, commitSha])
}

// SEC-01 — Append-only audit trail for all important mutations. Stores the
// actor, source, target, before/after (redacted) and a correlation id. Raw
// tokens are never stored; sensitive description/comment content is stored as
// metadata or a hash only (see audit.ts redaction).
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorEmail    String?
  action        String // e.g. "release.publish", "issue.transition", "user.role"
  source        String? // "web" | "chat" | "worker" | "api"
  target        String? // e.g. jira key, release id, user id
  before        Json?
  after         Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([target])
  @@index([correlationId])
}

// M7 — AI estimation. One row per issue; `scoredAt` marks the latest estimate.
// `confidence` (0..1), `missingInformation` and `similarTasks` make the
// suggestion explainable. `promptVersion` + `model` allow tracking which
// prompt produced the estimate. The estimate itself is NEVER written to Jira
// until a human accepts it (see AiEstimateDecision).
model AiScore {
  id                String   @id @default(cuid())
  jiraKey           String   @unique
  points            Int
  confidence        Float?
  reasoning         String   @default("")
  risks             String[]
  missingInformation String[] @default([])
  similarTasks      String[] @default([])
  model             String
  promptVersion     String?
  scoredAt          DateTime @default(now())
  issue             IssueCache @relation(fields: [jiraKey], references: [jiraKey], onDelete: Cascade)
  decisions         AiEstimateDecision[]

  @@index([scoredAt])
}

// M7-03 — Human review of an AI estimate. Records the decision (accept /
// edit / reject), the final points actually written to Jira (null for
// reject), and who/when. Kept separate from AiScore so the AI value and the
// final human value stay distinct for metrics (M7-04).
model AiEstimateDecision {
  id            String   @id @default(cuid())
  jiraKey       String
  scoreId       String
  decision      String // "accepted" | "edited" | "rejected"
  finalPoints   Int?
  decidedById   String
  decidedAt     DateTime @default(now())
  score         AiScore  @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([jiraKey, decidedAt])
  @@index([decision])
  @@index([decidedById])
}

model BranchInfo {
  id                  String    @id @default(cuid())
  repo                String
  branch              String
  jiraKey             String?
  latestCommitSha     String?
  lastCommitAt        DateTime?
  prId                Int?
  prTitle             String?
  prUrl               String?
  prState             String?
  prDestinationBranch String?
  prUpdatedAt         DateTime?
  merged              Boolean   @default(false)
  lastSeenAt          DateTime?
  deletedAt           DateTime?
  linkSource          String?   // explicit, branch_name, pr_title, jira_label, comment, manual
  linkConfidence      Int?      // 0..100
  linkState           String    @default("confirmed") // confirmed, suggested, rejected, manual_unlinked
  linkReason          String?
  suggestedJiraKey    String?
  linkReviewedAt      DateTime?
  linkReviewedById    String?
  checkedAt           DateTime  @default(now())

  issue               IssueCache? @relation(fields: [jiraKey], references: [jiraKey], onDelete: SetNull)

  @@unique([repo, branch])
  @@index([repo])
  @@index([merged])
  @@index([jiraKey])
  @@index([linkState])
  @@index([deletedAt, checkedAt])
  @@index([prState, merged])
  @@index([suggestedJiraKey])
}

enum ImportState {
  pending
  created
  failed
  ignored
}

model SentryIssueImported {
  id            String      @id @default(cuid())
  sentryIssueId String
  sentryProject String
  jiraKey       String?
  state         ImportState @default(pending)
  attemptCount  Int         @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  importedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([sentryProject, sentryIssueId])
  @@index([state, lastAttemptAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  eventKey   String    @default("")
  type       String
  severity   String    @default("info")
  title      String
  body       String    @default("")
  link       String?
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, eventKey])
  @@index([userId, read])
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model StaleSnapshot {
  id          String     @id @default(cuid())
  jiraKey     String
  assignee    String?
  ageDays     Int
  // M8 — per-status age metrics + classification.
  totalAgeDays   Int      @default(0)
  stateAgeDays   Int      @default(0)
  inactiveDays   Int      @default(0)
  blockedDays    Int      @default(0)
  stateAgeLowConfidence Boolean @default(false)
  staleReason    String   @default("unknown")
  severity       String   @default("warning")
  status         String   @default("")
  statusCategory String   @default("unknown")
  slaDays        Int      @default(7)
  detectedAt  DateTime   @default(now())
  issue       IssueCache @relation(fields: [jiraKey], references: [jiraKey], onDelete: Cascade)

  @@index([jiraKey])
  @@index([assignee])
  @@index([staleReason])
  @@index([severity])
  @@index([status])
  @@index([detectedAt])
}

// M5 — Minimal integration event store. Every inbound webhook is stored with
// its external event ID so duplicates are detected before processing. The
// raw payload is capped to keep the table small (see MAX_EVENT_PAYLOAD_BYTES).
model IntegrationEvent {
  id              String    @id @default(cuid())
  source          String
  externalId      String
  type            String
  subject         String?
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@unique([source, externalId])
  @@index([source, receivedAt])
}

  // M6 — Chat identity. One row per linked chat account. A user explicitly
  // links their chat account (e.g. Discord) to their Team Task Web profile;
  // chat commands then run with that user's role and Jira credential. The chat
  // token is never a Jira identity (ADR-005).
  model ChatIdentity {
    id        String  @id @default(cuid())
    provider  String  @default("discord")
    externalId String @unique
    displayName String?
    linkedById String?
    linkedAt  DateTime @default(now())
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String

    @@unique([provider, userId])
    @@index([userId])
  }

  // M5 — Notification preferences. One row per user; defaults allow everything.
  // `disabledTypes` is a list of event types that should not be delivered.
  // `deliveryMode` is "instant" or "digest" (digest delivered at most once a day).
  model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  disabledTypes     String[] @default([])
  pushEnabled       Boolean  @default(false)
  pushDisabledTypes String[] @default([])
  deliveryMode      String   @default("instant") // "instant" | "digest"
  digestHour        Int      @default(8) // local hour for the daily digest
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// M5 — Outbox for reliable notification delivery. Each Notification row is
// mirrored here; the delivery worker claims, retries with backoff, and marks
// the delivery outcome. `dedupeKey` prevents the same logical notification
// from being delivered twice (e.g. the same external event arriving twice).
enum DeliveryState {
  pending
  sent
  failed
  skipped
}

model NotificationOutbox {
  id            String         @id @default(cuid())
  notificationId String?
  userId        String
  channel       String         @default("in_app") // in_app | push
  title         String
  body          String         @default("")
  link          String?
  dedupeKey     String?
  state         DeliveryState  @default(pending)
  attemptCount  Int            @default(0)
  lastError     String?
  scheduledAt   DateTime? // set for digest-mode deliveries
  deliveredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([dedupeKey, channel])
  @@index([state, scheduledAt])
  @@index([userId])
}

// M4 — Bulk operations. A user requests a bulk change (preview), confirms it,
// and the worker processes items one-by-one with concurrency limits + retry.
enum OperationState {
  preview
  queued
  running
  completed
  partially_failed
  failed
  cancelled
}

model BulkOperation {
  id          String         @id @default(cuid())
  type        String
  requestedBy String
  // Action + parameters + the list of targeted Jira keys.
  payload     Json
  state       OperationState @default(preview)
  total       Int            @default(0)
  succeeded   Int            @default(0)
  failed      Int            @default(0)
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  items       BulkOperationItem[]

  @@index([state, createdAt])
  @@index([requestedBy, createdAt])
}

model BulkOperationItem {
  id           String   @id @default(cuid())
  operationId  String
  jiraKey      String
  before       Json?
  requested    Json
  after        Json?
  status       String // "pending" | "running" | "succeeded" | "failed" | "skipped"
  error        String?
  retryable    Boolean  @default(true)
  attemptCount Int      @default(0)
  operation    BulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, jiraKey])
  @@index([operationId, status])
}

// M6 — Chat command + result transcript. Every chat command and its outcome are
// stored with a stable correlation id so they can be audited and traced.
// `status` is one of: ok, preview, confirmed, rejected, error, blocked,
// unrecognized, linked, unlinked, help.
model ChatMessage {
  id            String   @id @default(cuid())
  provider      String   @default("discord")
  externalMsgId String?  // the chat platform's message id (for reply/correlate)
  externalAuthorId String
  authorUserId  String?  // linked Team Task Web user; null when unlinked
  command       String?  // normalized command verb (e.g. "move")
  raw           String
  status        String   @default("received")
  result        Json?
  correlationId String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([authorUserId, createdAt])
  @@index([provider, externalAuthorId])
}

// M6 — Pending bulk/mutating command confirmations. A preview creates a row;
// the user must confirm (or it expires) before any Jira mutation runs.
model ChatMessageConfirmation {
  id            String   @id @default(cuid())
  provider      String   @default("discord")
  externalAuthorId String
  userId        String
  kind          String
  payload       Json
  status        String   @default("pending") // pending | confirmed | expired
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}


