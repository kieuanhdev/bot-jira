  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "lint": "eslint src scripts prisma",
