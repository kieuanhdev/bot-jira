    "@prisma/client": "^7.10.0",
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@tanstack/react-query": "^5.104.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "isomorphic-dompurify": "^4.6.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
