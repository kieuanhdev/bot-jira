{
  "name": "teamweb-skel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "lint": "eslint --max-warnings=0 src scripts prisma",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "backfill:people": "tsx --env-file-if-exists=.env scripts/backfill-people-fields.ts",
    "test": "vitest run",
    "test:tz": "TZ=Asia/Ho_Chi_Minh vitest run",
    "test:db": "node scripts/run-db-integration-tests.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
